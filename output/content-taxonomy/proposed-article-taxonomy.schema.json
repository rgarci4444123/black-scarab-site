{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.blackscarab.ai/schemas/article-taxonomy-v1.json",
  "title": "Proposed article taxonomy",
  "description": "Review artifact. The identifier does not create a website endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primaryIndustry",
    "technologies",
    "applications"
  ],
  "properties": {
    "primaryIndustry": {
      "type": "string",
      "enum": [
        "manufacturing",
        "construction",
        "warehousing-logistics",
        "transportation-mobility",
        "mining",
        "energy-utilities",
        "agriculture",
        "healthcare-life-sciences",
        "data-centers",
        "public-safety-government",
        "retail",
        "hospitality-services",
        "consumer-home",
        "defense-aerospace",
        "cross-industry"
      ]
    },
    "relevantIndustries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "manufacturing",
          "construction",
          "warehousing-logistics",
          "transportation-mobility",
          "mining",
          "energy-utilities",
