{
  "name": "black-scarab-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:glossary && npm run build:bspi15-performance && npm run build:insight-social-images && npm run validate:news-social-images && npm run validate:content-taxonomy && next build && npm run validate:article-previews",
    "audit:bspi15-marketstack": "node scripts/audit-bspi15-marketstack.mjs",
    "build:bspi15-performance": "node scripts/build-bspi15-performance.mjs",
    "build:insight-social-images": "node scripts/build-insight-social-images.mjs",
    "validate:article-previews": "node scripts/validate-article-previews.mjs",
    "start": "next start",
    "lint": "eslint",
    "validate:news-social-images": "node scripts/validate-news-social-images.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "validate:content-taxonomy": "node scripts/validate-content-taxonomy.mjs",
    "test:content-taxonomy": "node --test scripts/content-taxonomy.test.mjs",
    "test:referral-analytics": "node --test scripts/referral-analytics.test.mjs",
    "validate:glossary": "node scripts/validate-glossary.mjs",
    "test:glossary": "node --test scripts/glossary-publication.test.mjs scripts/glossary-preview.test.mjs scripts/glossary-linking.test.mjs scripts/glossary-analytics.test.mjs",
    "report:glossary": "node scripts/validate-glossary.mjs --report",
    "review:glossary": "node scripts/review-glossary.mjs",
    "dev:glossary-preview": "BLACK_SCARAB_GLOSSARY_PREVIEW=1 next dev --webpack --hostname 127.0.0.1 --port 3099"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.1",
    "nodemailer": "^10.0.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/opentype.js": "^1.3.10"
  }
}
